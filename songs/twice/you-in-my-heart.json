  "lines": [
    {"lyric": "Jami oji anneun oneul bame",
      "lyric_hangul": "잠이 오지 않는 오늘 밤에",
      "lyric_translation": "I can’t sleep tonight",
      "range": [12.29, 15.68], "ans": [1]},
    {"lyric": "Na udukeoni anja",
      "lyric_hangul": "나 우두커니 앉아",
      "lyric_translation": "So I’m sitting here",
      "range": [15.68, 18.1], "ans": [1]},
    {"lyric": "Banjjagineun jeo haneul bomyeo",
      "lyric_hangul": "반짝이는 저 하늘 보며",
      "lyric_translation": "Looking at the twinkling sky",
      "range": [18.1, 21.63], "ans": [1]},
    {"lyric": "Hana dul sshik byeol heneun i bame",
      "lyric_hangul": "하나 둘 씩 별 헤는 이 밤에",
      "lyric_translation": "One by one, the stars shine",
      "range": [21.63, 24.81], "ans": [3]},
    {"lyric": "And all day",
      "lyric_hangul": "And all day",
      "lyric_translation": "And all day",
      "range": [24.81, 27.57], "ans": [7]},
    {"lyric": "Baramkkyeore seureuk nun gama",
      "lyric_hangul": "바람결에 스륵 눈 감아",
      "lyric_translation": "I close my eyes with the wind",
      "range": [27.57, 30.38], "ans": [3]},
    "",
    {"lyric": "Sarangseureon ni sumkkyeol",
      "lyric_hangul": "사랑스런 네 숨결",
      "lyric_translation": "Your loving breath",
      "range": [30.38, 33.41], "ans": [6]},
    {"lyric": "Budeureoun moksoriro nae mame",
      "lyric_hangul": "부드러운 목소리로 내 맘에",
      "lyric_translation": "Your soft voice",
      "range": [33.41, 36.66], "ans": [4]},
    {"lyric": "Seumyeodeureo nal bichweo juneun neo",
      "lyric_hangul": "스며들어 날 비춰주는 너",
      "lyric_translation": "Enters my heart and shines on me",
      "range": [36.66, 39.85], "ans": [4]},
    {"lyric": "Nae mami kkok ireon geol",
      "lyric_hangul": "내 맘이 꼭 이런 걸",
      "lyric_translation": "This is how I feel",
      "range": [39.85, 42.75], "ans": [6]},
    {"lyric": "Pogeunhi nae pum ane",
      "lyric_hangul": "포근히 내 품 안에",
      "lyric_translation": "I want to hold you softly",
      "range": [42.75, 45.05], "ans": [4]},
    {"lyric": "Damkko shipeun neoya",
      "lyric_hangul": "담고 싶은 너야",
      "lyric_translation": "In my arms",
      "range": [45.05, 47.58], "ans": [4]},
    "",
    {"lyric": "Nae nuneul barabwa",
      "lyric_hangul": "내 눈을 바라봐",
      "lyric_translation": "Look into my eyes",
      "range": [47.58, 49.02], "ans": [7]},
    {"lyric": "Negeman da boyeojulkke",
