  "lines": [
    {"lyric": "Geureon nari isseo",
      "lyric_hangul": "그런 날이 있어",
      "lyric_translation": "There are one of those days",
      "range": [13.67, 15.86], "ans": [8]},
    {"lyric": "Gapjagi honjain geonman gateun nal",
      "lyric_hangul": "갑자기 혼자인 것만 같은 날",
      "lyric_translation": "Days when I suddenly feel all alone",
      "range": [15.86, 19.46], "ans": [8]},
    {"lyric": "Eodil gado nae jariga anin geonman gatgo",
      "lyric_hangul": "어딜 가도 내 자리가 아닌 것만 같고",
      "lyric_translation": "When I feel like I don’t belong anywhere",
      "range": [19.46, 23.76], "ans": [8]},
    {"lyric": "Gogaen tteolgweojineun nal",
      "lyric_hangul": "고갠 떨궈지는 날",
      "lyric_translation": "And my head is hanging down",
      "range": [23.76, 27.95], "ans": [8]},
    "",
    {"lyric": "Geureol ttaemada naege",
      "lyric_hangul": "그럴 때마다 내게",
      "lyric_translation": "Whenever those days come, you tell me",
      "range": [27.95, 30.16], "ans": [9]},
    {"lyric": "Eolmana naega sojunghanji",
      "lyric_hangul": "얼마나 내가 소중한지",
      "lyric_translation": "How precious I am",
      "range": [30.16, 33.32], "ans": [9]},
    {"lyric": "Malhaejuneun neoye geu hanmadie",
      "lyric_hangul": "말해주는 너의 그 한마디에",
      "lyric_translation": "All those words you say",
      "range": [33.32, 37.59], "ans": [9]},
    {"lyric": "Everything’s alright",
      "lyric_hangul": "Everything's alright",
      "lyric_translation": "Everything’s alright",
      "range": [37.59, 39.44], "ans": [3]},
    {"lyric": "Chorahan Nobodyeseo dashi Somebody",
      "lyric_hangul": "초라한 Nobody 에서 다시 Somebody",
      "lyric_translation": "From Nobody to Somebody",
      "range": [39.44, 42.85], "ans": [3]},
    {"lyric": "Teukbyeolhan naro byeonhae",
      "lyric_hangul": "특별한 나로 변해",
      "lyric_translation": "I become a very special me",
      "range": [42.85, 45.14], "ans": [3]},
    "",
    {"lyric": "You make me feel special",
      "lyric_hangul": "You make me feel special",
      "lyric_translation": "You make me feel special",
      "range": [45.14, 48.0], "ans": [4]},
    {"lyric": "Sesangi amuri nal jujeoancheodo",
      "lyric_hangul": "세상이 아무리 날 주저앉혀도 (앉혀도)",
      "lyric_translation": "No matter how the world brings me down",
