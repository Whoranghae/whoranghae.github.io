    {"lyric": "I sesang soge yeongungi dwen na", "lyric_hangul": "이 세상 속에 영웅이 된 나", "lyric_translation": "I became a hero in this world", "range": [81.92, 84.79], "ans": [3]},
    {"lyric": "Nareul chatneun keun hwanhowa", "lyric_hangul": "나를 찾는 큰 환호와", "lyric_translation": "Shouts that look for me", "range": [84.79, 87.12], "ans": [3]},
