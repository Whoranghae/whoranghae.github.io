  "lines": [
    {"lyric": "Mueonga kkaejineun sori", "lyric_hangul": "무언가 깨지는 소리", "lyric_translation": "I hear something shattering", "range": [1.14, 7.81], "ans": [6]},
    {"lyric": "Nan mundeuk jameseo kkae", "lyric_hangul": "난 문득 잠에서 깨", "lyric_translation": "It suddenly wakes me up", "range": [7.81, 14.96], "ans": [6]},
    {"lyric": "Nasseoreum gadeukhan sori", "lyric_hangul": "낮설음 가득한 소리", "lyric_translation": "I hear strange sounds", "range": [14.96, 20.4], "ans": [6]},
    {"lyric": "Gwireul magabojiman jame deulji mothae", "lyric_hangul": "귀를 막아 보지만 잠엘 들지 못해", "lyric_translation": "I try covering my ears but I can’t fall back asleep", "range": [20.4, 27.16], "ans": [6]},
    "",
    {"lyric": "Mogi jakku apawa", "lyric_hangul": "목이 자꾸 아파와", "lyric_translation": "My throat keeps hurting", "range": [27.16, 33.85], "ans": [6]},
    {"lyric": "Gamssaboryeo hajiman", "lyric_hangul": "감싸 보려하지만", "lyric_translation": "I try to wrap it", "range": [33.85, 40.81], "ans": [6]},
    {"lyric": "Naegen moksoriga eopseo", "lyric_hangul": "나에겐 목소리가 없어", "lyric_translation": "But I have no voice", "range": [40.81, 44.97], "ans": [6]},
    {"lyric": "Oneuldo geu soril deureo", "lyric_hangul": "오 오늘도 그 소릴 들어", "lyric_translation": "Again today, I hear that sound", "range": [44.97, 53.32], "ans": [6]},
    "",
    {"lyric": "Tto ulligo isseo geu soriga", "lyric_hangul": "또 울리고있어 그 소리가", "lyric_translation": "That sound is ringing again", "range": [53.32, 60.49], "ans": [6]},
    {"lyric": "I eoreobuteun hosue tto geumi ga", "lyric_hangul": "이얼어붙은 호수에 또 금이 가", "lyric_translation": "Another crack forms on this frozen lake", "range": [60.49, 67.44], "ans": [6]},
    {"lyric": "Geu hosue naega nal beoryeotjana", "lyric_hangul": "그 호수에 내가 날 버렸잖아", "lyric_translation": "I left myself behind on that lake", "range": [67.44, 73.82], "ans": [6]},
    {"lyric": "Nae moksoril neol wihae mudeotjana", "lyric_hangul": "내 목소릴 널 위해 묻었잖아", "lyric_translation": "My voice was buried for you", "range": [73.82, 81.5], "ans": [6]},
    "",
    {"lyric": "Nal beorin gyeoul hosu wiro", "lyric_hangul": "날 버린 겨울 호수 위로", "lyric_translation": "Above the winter lake where I’m left alone", "range": [83.97, 91.09], "ans": [6]},
    {"lyric": "Dukkeoun eoreumi eoreotne", "lyric_hangul": "두꺼운 얼음이 얼었네", "lyric_translation": "There’s a thick sheet of ice", "range": [91.09, 97.9], "ans": [6]},
    {"lyric": "Jamshi deureogan kkum sogedo", "lyric_hangul": "잠시 들어간 꿈 속에도", "lyric_translation": "Even in my momentary dreams", "range": [97.9, 103.47], "ans": [6]},
    {"lyric": "Nareul goerobhineun hwansangtongeun yeojeonhae", "lyric_hangul": "나를 괴롭히는 환상 통은 여전해 (Hmm)", "lyric_translation": "The illusions that torture me are still the same", "range": [103.47, 110.22], "ans": [6]},
    "",
    "[next-col]",
    {"lyric": "Naneun nal ireun geolkka", "lyric_hangul": "나는 날 잃은 걸까", "lyric_translation": "Did I lose myself?", "range": [110.22, 117.45], "ans": [6]},
    {"lyric": "Ani neol eodeum geolkka", "lyric_hangul": "아님 널 잃은 걸까", "lyric_translation": "Or did I gain you?", "range": [117.45, 123.8], "ans": [6]},
    {"lyric": "Nan mundeuk hosuro dallyeoga", "lyric_hangul": "나 문득 호수로 달려가", "lyric_translation": "I started to run to the lake", "range": [123.8, 129.49], "ans": [6]},
    {"lyric": "Geu sogen nae eolguri isseo", "lyric_hangul": "오 그 속에 내 얼굴 있어", "lyric_translation": "Inside, I saw my face", "range": [129.49, 136.36], "ans": [6]},
    "",
    {"lyric": "Butakhae amu maldo haji ma", "lyric_hangul": "부탁해 아무 말도하지 마", "lyric_translation": "Please, don’t say anything", "range": [136.36, 142.96], "ans": [6]},
    {"lyric": "Ibeul mageuryeo soneul ppeodeobojiman", "lyric_hangul": "입을 막으려 손을 뻗어 보지만", "lyric_translation": "I hold out my hand to cover your mouth", "range": [142.96, 149.87], "ans": [6]},
    {"lyric": "Gyeolgugen eonjenga bomi wa", "lyric_hangul": "결국엔 언젠가 봄이와", "lyric_translation": "But in the end, spring will come some day", "range": [149.87, 157.34], "ans": [6]},
    {"lyric": "Eoreumdeureun noganaeryeo heulleoga", "lyric_hangul": "얼음들은 녹아 내려 흘러 가", "lyric_translation": "The ice will melt away", "range": [157.34, 164.57], "ans": [6]},
    "",
    {"lyric": "Tell me nae moksoriga gajjaramyeon", "lyric_hangul": "Tell me 내 목소리가 가짜라면 (Ahh)", "lyric_translation": "Tell me, if my voice is fake", "range": [164.57, 171.21], "ans": [6]},
    {"lyric": "Nal beoriji marasseoya haetneunji", "lyric_hangul": "날 버리지 말았어야했는지 (Oh Wow)", "lyric_translation": "Should I have not thrown myself away?", "range": [171.21, 177.72], "ans": [6]},
    {"lyric": "Tell me i gotongjocha gajjaramyeon", "lyric_hangul": "Tell me 고통조차 가짜라면", "lyric_translation": "Tell me, if this pain is fake", "range": [177.72, 185.14], "ans": [6]},
