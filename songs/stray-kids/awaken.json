      "range": [19.07, 21.7], "ans": [1]},
    {"lyric": "Geudongan nan nuguyeotteon geolkka",
      "lyric_hangul": "그동안 난 누구였던 걸까",
      "lyric_translation": "Who was I for all this time?",
      "range": [21.7, 24.7], "ans": [1]},
    "",
    {"lyric": "Byeorak majeun deushi onmome jeonyuri dodatji",
      "lyric_hangul": "벼락 맞은 듯이 온몸에 전율이 돋았지",
      "lyric_translation": "Shivers all over my body as if I was struck by lightning",
      "range": [24.7, 27.48], "ans": [3]},
    {"lyric": "Hanadulsshik seuchyeo",
      "lyric_hangul": "하나둘씩 스쳐 가는",
      "lyric_translation": "Strange feelings",
      "range": [27.48, 28.49], "ans": [3]},
    {"lyric": "Ganeun natseon neukkim geudongan mollatji",
      "lyric_hangul": "낯선 느낌 그동안 몰랐지",
      "lyric_translation": "Pass through me one by one, I didn’t know until now",
      "range": [28.49, 30.36], "ans": [3]},
    {"lyric": "Naneun nande naneun nande naneun nande",
      "lyric_hangul": "나는 난데 나는 난데 나는 난데",
      "lyric_translation": "I’m me, I’m me, I’m me",
      "range": [30.36, 31.54], "ans": [3]},
    {"lyric": "Naneun nande mweoga munje",
      "lyric_hangul": "나는 난데 뭐가 문제",
      "lyric_translation": "I’m me so what’s the problem?",
      "range": [31.54, 33.71], "ans": [3]},
    {"lyric": "Ireom an dwae ireom an dweneunde",
      "lyric_hangul": "이럼 안 돼 이럼 안 되는데",
      "lyric_translation": "I shouldn’t, I shouldn’t do this",
      "range": [33.71, 34.65], "ans": [3]},
    {"lyric": "Igeon mweonde daeche nugunde",
      "lyric_hangul": "이건 뭔데 대체 누군데",
      "lyric_translation": "What is this? Who is this?",
      "range": [34.65, 36.25], "ans": [3]},
    {"lyric": "Eodil gado neon sumgiman hago ey",
      "lyric_hangul": "어딜 가도 넌 숨기만 하고 ey",
      "lyric_translation": "Wherever I go, you only hide",
      "range": [36.25, 39.18], "ans": [4]},
    {"lyric": "Ttaragado deo ppalli domanggago what",
      "lyric_hangul": "따라가도 더 빨리 도망가고 what",
      "lyric_translation": "I follow you but you run away even faster",
      "range": [39.18, 42.15], "ans": [4]},
    {"lyric": "Gollanham puljireul molla hollanman keojineun hollan",
      "lyric_hangul": "곤란함 풀지를 몰라 혼란만 커지는 혼란",
      "lyric_translation": "Don’t know how to figure this out, confusion is only growing",
      "range": [42.15, 44.87], "ans": [3]},
    {"lyric": "Naega naega anin geot gatdaneun geol kkaedara",
      "lyric_hangul": "내가 내가 아닌 것 같다는 걸",
      "lyric_translation": "I realized I wasn’t being myself",
      "range": [44.87, 46.43], "ans": [3]},
    {"lyric": "Nae ane soran",
      "lyric_hangul": "깨달아 내 안의 소란",
      "lyric_translation": "A riot is happening inside me",
      "range": [46.43, 48.06], "ans": [3]},
    "",
    {"lyric": "Amureon saenggak eopshi jinaedeon ttaega",
