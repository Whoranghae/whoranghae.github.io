  "lines": [
    {"lyric": "Bulpyeonhan sok there’s something wrong",
      "lyric_hangul": "불편한 속 There's something wrong",
      "lyric_translation": "I don’t feel good, there’s something wrong",
      "range": [0.84, 3.11], "ans": [6]},
    {"lyric": "Cheoeumeuro nareul bwasseosseo",
      "lyric_hangul": "처음으로 나를 봤었어",
      "lyric_translation": "I saw myself for the first time",
      "range": [3.11, 6.02], "ans": [6]},
    {"lyric": "Neoneun nuguya jilmuneul deonjyeosseo",
      "lyric_hangul": "너는 누구야 질문을 던졌어",
      "lyric_translation": "Who are you? I threw the question out there",
      "range": [6.02, 11.93], "ans": [6]},
