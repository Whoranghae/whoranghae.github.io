  "lines": [
    {"lyric": "Shwiji anko dallyeowatneunde wae",
      "lyric_hangul": "쉬지 않고 달려왔는데 왜",
      "lyric_translation": "I ran all the way here without rest so why",
      "range": [9.16, 11.53], "ans": [4]},
    {"lyric": "Ajik jubyeoneun eodubgiman hae wae",
      "lyric_hangul": "아직 주변은 어둡기만 해 왜",
      "lyric_translation": "Is everything around me still so dark?",
      "range": [11.53, 14.02], "ans": [4]},
    {"lyric": "Shigani haegyeolhae jul georaneun mal",
      "lyric_hangul": "시간이 해결해 줄 거라는 말",
      "lyric_translation": "They say time will solve everything",
      "range": [14.02, 16.43], "ans": [4]},
    {"lyric": "Naegen geujeo duryeoumppunin mal",
      "lyric_hangul": "내겐 그저 두려움뿐인 말",
      "lyric_translation": "But those words just give me fear",
      "range": [16.43, 18.52], "ans": [7]},
    "",
    {"lyric": "Shigani haegyeolhal su eopseo",
      "lyric_hangul": "시간이 해결할 수 없어",
      "lyric_translation": "Time can’t solve this",
      "range": [18.52, 20.78], "ans": [3]},
    {"lyric": "Gidaridagan gyeolguk butjabhyeo mwodeun haeya hae",
      "lyric_hangul": "기다리다간 결국 붙잡혀 뭐든 해야 해",
      "lyric_translation": "If I wait, I’ll get caught, I need to do something",
      "range": [20.78, 22.25], "ans": [3]},
    {"lyric": "Nan dareun su eopseo",
      "lyric_hangul": "난 다른 수 없어",
      "lyric_translation": "I have no other way",
      "range": [22.25, 23.14], "ans": [3]},
    {"lyric": "Igose shiganeun geumilkka geumsuilkka",
      "lyric_hangul": "이곳의 시간은 금일까 금수일까",
      "lyric_translation": "Is time here gold or a beast?",
      "range": [23.14, 25.63], "ans": [3]},
    {"lyric": "Sullaejabgi sok jabhineun geon nailkka kkumilkka",
      "lyric_hangul": "술래잡기 속 잡히는 건 나일까 꿈일까",
      "lyric_translation": "When I get caught from hide and seek, is it me or is it a dream?",
      "range": [25.63, 28.79], "ans": [3]},
    "",
    {"lyric": "Day and night maeil nan",
      "lyric_hangul": "Day and night 매일 난",
      "lyric_translation": "Day and night, every day",
      "range": [28.79, 33.36], "ans": [1]},
    {"lyric": "Geobi na butjabhil geot gateunde",
      "lyric_hangul": "겁이 나 붙잡힐 것 같은데",
      "lyric_translation": "Fear holds onto me",
      "range": [33.36, 39.1], "ans": [1]},
    "",
    {"lyric": "Bakchago dallyeoga sumi chado",
      "lyric_hangul": "박차고 달려가 숨이 차도",
      "lyric_translation": "I’m kicking it away and running, even if I run out of breath",
      "range": [39.1, 42.65], "ans": [5]},
    {"lyric": "Kkeunimeopshi dallyeo",
      "lyric_hangul": "끊임없이 달려",
      "lyric_translation": "I’m running endlessly",
      "range": [42.65, 44.19], "ans": [6]},
    {"lyric": "Shiganeun wae naege ppalli dallyeooneunde",
