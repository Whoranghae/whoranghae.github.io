    {"lyric": "Amugeotto uijihaji mothae",
      "lyric_hangul": "아무것도 의지하지 못해",
      "lyric_translation": "",
      "range": [76.31, 78.16], "ans": [3]},
    {"lyric": "Seuseuro na jashinmaneul uijihagil seontaek",
      "lyric_hangul": "스스로 나 자신만을 의지하길 선택",
      "lyric_translation": "",
      "range": [78.16, 81.07], "ans": [3]},
    {"lyric": "Geureodeon naega heundeulligo inneun jigeum nan",
      "lyric_hangul": "그러던 내가 흔들리고 있는 지금 난",
      "lyric_translation": "",
      "range": [81.07, 83.32], "ans": [3]},
    {"lyric": "Daeche nugureul butjabaya haneun geolkka",
      "lyric_hangul": "대체 누구를 붙잡아야 하는 걸까",
      "lyric_translation": "",
      "range": [83.32, 86.11], "ans": [3]},
    {"lyric": "Jeone naega son ollyeotteon eokkae ape",
      "lyric_hangul": "전에 내가 손 올렸던 어깨 앞에",
      "lyric_translation": "",
      "range": [86.11, 88.7], "ans": [3]},
    {"lyric": "Geuboda deo chuk cheojyeo beorin nae eokkaeneun who cares",
      "lyric_hangul": "그보다 더 축 처져 버린 내 어깨는 who cares",
      "lyric_translation": "",
      "range": [88.7, 91.38], "ans": [3]},
    {"lyric": "Teoreonochil mothae da teoreonochil mothae",
      "lyric_hangul": "털어놓질 못해 다 털어놓질 못해",
      "lyric_translation": "",
      "range": [91.38, 93.38], "ans": [3]},
    {"lyric": "Teoreonaeji mothan apeumeun gyeolguk",
      "lyric_hangul": "털어내지 못한 아픔은 결국",
      "lyric_translation": "",
      "range": [93.38, 95.57], "ans": [3]},
    {"lyric": "Nae jashineul tathae",
      "lyric_hangul": "내 자신을 탓해",
      "lyric_translation": "",
      "range": [95.57, 96.52], "ans": [3]},
    {"lyric": "Takhan gonggi soge sumeul deurikyeoda bomyeon",
      "lyric_hangul": "탁한 공기 속에 숨을 들이켜다 보면",
      "lyric_translation": "",
      "range": [96.52, 99.04], "ans": [3]},
    {"lyric": "Bulkwaehameul neomeo sumi neomeogal deut heoltteokkeoryeo",
      "lyric_hangul": "불쾌함을 넘어 숨이 넘어갈 듯 헐떡거려",
      "lyric_translation": "",
      "range": [99.04, 101.12], "ans": [3]},
    {"lyric": "Amugeotto anin maldo gwaenhi shingyeong sseuge dwae",
      "lyric_hangul": "아무것도 아닌 말도 괜히 신경 쓰게 돼",
      "lyric_translation": "",
      "range": [101.12, 103.11], "ans": [3]},
    {"lyric": "Amugeotto anin geotto amureochi anchi ana",
      "lyric_hangul": "아무것도 아닌 것도 아무렇지 않지 않아",
      "lyric_translation": "",
      "range": [103.11, 105.85], "ans": [3]},
    {"lyric": "Jubyeone shiseon nal hyanghan geotto aninde",
      "lyric_hangul": "주변의 시선 날 향한 것도 아닌데",
      "lyric_translation": "",
      "range": [105.85, 108.34], "ans": [3]},
    {"lyric": "Ttagapge neukkyeojyeo",
      "lyric_hangul": "따갑게 느껴져",
      "lyric_translation": "",
      "range": [108.34, 109.49], "ans": [3]},
    {
      "lyric_hangul": "감췄던 표정 잠깐 망보다가 들켜 드러나게 될까",
      "parts": [
        {"lyric": "Gamchweotteon pyojeong jamkkan mangbodaga",
