      "range": [16.99, 18.96], "ans": [3]},
    "",
    {"lyric": "Ti naego shipji ana nayakhae ppajin nae moseup",
      "lyric_hangul": "티 내고 싶지 않아 나약해 빠진 내 모습",
      "lyric_translation": "",
      "range": [18.96, 21.56], "ans": [3]},
    {"lyric": "Nal uijihaetteon geudeuregen i moseubeun mosun",
      "lyric_hangul": "날 의지했던 그들에겐 이 모습은 모순",
      "lyric_translation": "",
      "range": [21.56, 24.55], "ans": [3]},
    {"lyric": "Ganghan cheok an apeun cheok amureochi aneun cheok",
      "lyric_hangul": "강한 척 안 아픈 척 아무렇지 않은 척",
      "lyric_translation": "",
      "range": [24.55, 26.45], "ans": [3]},
    {"lyric": "Geujeo nugungaege himi dwego shipeun nande",
      "lyric_hangul": "그저 누군가에게 힘이 되고 싶은 난데",
      "lyric_translation": "",
      "range": [26.45, 29.14], "ans": [3]},
    {"lyric": "Naro inhae geudeure himeul ppaemyeon an dwae",
      "lyric_hangul": "나로 인해 그들의 힘을 빼면 안 돼",
      "lyric_translation": "",
      "range": [29.14, 31.31], "ans": [3]},
    {
      "lyric_hangul": "\"기대도 돼\"란 말에 물음표를 붙일 용기가 없어 난",
      "parts": [
        {"lyric": "“gidaedo dwae”ran mare",
          "range": [31.31, 32.99], "ans": [3]},
        {"lyric": "Mureumpyoreul buchil yonggiga eopseo nan",
          "range": [32.99, 35.01], "ans": [3]}
      ]
    },
    {
      "lyric_hangul": "아픔은 나갈 문이 없는 방 안에서 갇힌 채로 소리 없이 커져가",
      "parts": [
        {"lyric": "Apeumeun nagal muni eomneun bang aneseo gachin chaero",
          "range": [34.84, 37.76], "ans": [3]},
        {"lyric": "Sori eopshi keojyeoga",
          "range": [37.76, 38.82], "ans": [3]}
      ]
    },
    "",
    {"lyric": "Chameul mankeum chamaboni mudyeojideora",
      "lyric_hangul": "참을 만큼 참아보니 무뎌지더라",
      "lyric_translation": "",
      "range": [38.35, 40.71], "ans": [3]},
    {"lyric": "Ajik gyeondil mananga bwa chamajinikka",
      "lyric_hangul": "아직 견딜 만한가 봐 참아지니까",
      "lyric_translation": "",
      "range": [40.71, 43.42], "ans": [3]},
    {"lyric": "Sangcheo wiye baendeuneun gyeolguk tteoreojigi maryeon",
      "lyric_hangul": "상처 위의 밴드는 결국 떨어지기 마련",
      "lyric_translation": "",
      "range": [43.42, 45.63], "ans": [3]},
    {"lyric": "Geuphi buchigin haenneunde eolma mot ga dashi kkajyeo",
      "lyric_hangul": "급히 붙이긴 했는데 얼마 못 가 다시 까져",
      "lyric_translation": "",
      "range": [45.63, 48.22], "ans": [3]},
    {"lyric": "Heoreobeorin jibung wiro ssayeoganeun binmureun",
      "lyric_hangul": "헐어버린 지붕 위로 쌓여가는 빗물은",
      "lyric_translation": "",
      "range": [48.22, 50.54], "ans": [3]},
    {"lyric": "Nae binteumeul eojjina jal aneunji saego saegil banbok",
      "lyric_hangul": "내 빈틈을 어찌나 잘 아는지 새고 새길 반복",
      "lyric_translation": "",
      "range": [50.54, 52.92], "ans": [3]},
    {"lyric": "Nugunga piryohae modu muneojigi jeone",
      "lyric_hangul": "누군가 필요해 모두 무너지기 전에",
      "lyric_translation": "",
      "range": [52.92, 55.17], "ans": [3]},
    {"lyric": "Dashi mureobwa jweo gwaenchannyago eoneu nugurado",
      "lyric_hangul": "다시 물어봐 줘 괜찮냐고 어느 누구라도",
      "lyric_translation": "",
      "range": [55.17, 57.3], "ans": [3]},
    "",
