  "slots": [],
  "lines": [
    {"lyric": "Shiganeun heulleoga",
      "lyric_hangul": "시간은 흘러가",
      "lyric_translation": "Time goes by",
      "range": [4.53, 6.52], "ans": [3]},
    {"lyric": "Gilgeman neukkyeojeotteon nae harureul dorabwa",
      "lyric_hangul": "길게만 느껴졌던 내 하루를 돌아봐",
      "lyric_translation": "I look back on today, it seemed too long",
      "range": [6.52, 10.85], "ans": [3]},
    {"lyric": "Jjalkkiman hande geuttaeneun mollasseotji",
      "lyric_hangul": "짧기만 한데 그때는 몰랐었지",
      "lyric_translation": "It was short but I didn’t realize it",
      "range": [10.85, 12.74], "ans": [3]},
    {"lyric": "Geunyang jinacheotteon geotteul",
      "lyric_hangul": "그냥 지나쳤던 것들",
      "lyric_translation": "All the things that I passed by",
      "range": [12.74, 15.18], "ans": [3]},
    {"lyric": "Oneul ttara deo bogoman shipeojineun",
      "lyric_hangul": "오늘따라 더 보고만 싶어지는",
      "lyric_translation": "I want to see the beautiful memories",
      "range": [15.18, 20.4], "ans": [3]},
    {"lyric": "Dwedollil sun eomneun areumdaun gieoktteul",
      "lyric_hangul": "되돌릴 순 없는 아름다운 기억들",
      "lyric_translation": "That can’t be turned back",
      "range": [20.4, 26.24], "ans": [3]},
    "",
    {"lyric": "Sonmogeseo heureuneun pi gateun shigan",
      "lyric_hangul": "손목에서 흐르는 피 같은 시간",
      "lyric_translation": "Precious time flows from the watch on my wrist",
      "range": [26.24, 28.48], "ans": [1]},
    {"lyric": "Gieogeun tteonaeryeoga eoneusae neolbeun bada",
      "lyric_hangul": "기억은 떠내려가 어느새 넓은 바다",
      "lyric_translation": "Memories wash away and end up as a wide ocean",
      "range": [28.48, 31.44], "ans": [1]},
    {"lyric": "Gwageowa hyeonjae heureuneun geon ttokkatjiman",
      "lyric_hangul": "과거와 현재 흐르는 건 똑같지만",
      "lyric_translation": "The past and the present flow the same way",
      "range": [31.44, 34.65], "ans": [1]},
    {"lyric": "Japji motan geotteure daehan huhwega nama",
      "lyric_hangul": "잡지 못한 것들에 대한 후회가 남아",
      "lyric_translation": "But I have regrets about missed opportunities",
      "range": [34.65, 36.91], "ans": [1]},
    {"lyric": "Eoreuni dwellam meoreonna bwa",
      "lyric_hangul": "어른이 될 람 멀었나 봐",
      "lyric_translation": "Guess I’m still far from becoming an adult",
      "range": [36.91, 38.49], "ans": [1]},
    {"lyric": "Ani dwegi shilta eorigwang burineun geonga bwa",
      "lyric_hangul": "아니 되기 싫다 어리광 부리는 건 가봐",
      "lyric_translation": "Or no, I just don’t want to, guess I’m acting like baby",
      "range": [38.49, 41.12], "ans": [1]},
    {"lyric": "Al su eomneun naldeureun japji motaeseo",
      "lyric_hangul": "알 수 없는 날들은",
      "lyric_translation": "Unknown days keep washing down",
      "range": [41.12, 42.82], "ans": [1]},
    {"lyric": "Gyesok tteonaeryeowa",
      "lyric_hangul": "잡지 못해서 계속 떠내려와",
      "lyric_translation": "Because I can’t hold on",
      "range": [42.82, 44.49], "ans": [1]},
    {"lyric": "Momeul matgin chae i shigane tto tteonaeryeoga",
      "lyric_hangul": "몸을 맡긴 채 이 시간에 또 떠내려가",
      "lyric_translation": "I let the time take control and let it wash me away",
      "range": [44.49, 47.04], "ans": [1]},
    "",
    {"lyric": "Hangsang heulleoganeun geujeo geureon ildeul",
      "lyric_hangul": "항상 흘러가는 그저 그런 일들",
      "lyric_translation": "All the trivial things that keep washing away",
      "range": [47.04, 49.28], "ans": [11]},
    {"lyric": "Soge meolli tteonaga beorin niga",
