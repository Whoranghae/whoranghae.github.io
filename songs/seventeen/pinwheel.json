  "lines": [
    {"lyric": "Neoreul gidarida barabwasseo",
      "lyric_hangul": "너를 기다리다 바라봤어",
      "lyric_translation": "I waited for you",
      "range": [11.13, 14.07], "ans": [2]},
    {"lyric": "Jeogi jeogi meolli eoneu saenga",
      "lyric_hangul": "저기 저기 멀리 어느샌가",
      "lyric_translation": "From far away",
      "range": [14.07, 17.35], "ans": [2]},
    {"lyric": "Chan barami gyesok buneun geo gata",
      "lyric_hangul": "찬바람이 계속 부는 거 같아",
      "lyric_translation": "Cold wind keeps blowing",
      "range": [17.35, 21.32], "ans": [2]},
    "",
    {"lyric": "Aju jageun baramgaebi",
